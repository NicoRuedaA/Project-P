.toon-style { flex-grow: 1; padding: 12px; }
.toon-style .heading { -unity-font-style: bold; margin-bottom: 8px; }
.toon-style .description { white-space: normal; margin-bottom: 12px; }
.toon-style .field { margin-bottom: 6px; }
.toon-style .apply { margin-top: 12px; margin-bottom: 8px; min-height: 28px; }
.toon-style .status { white-space: normal; }

.toon-style .section { -unity-font-style: bold; margin-top: 12px; margin-bottom: 8px; }
